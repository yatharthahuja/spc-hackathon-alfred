# OpenAI — required for VLM orchestration (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here
OPENAI_VLM_MODEL=gpt-4o

# Webcam device index (usually 0)
CAMERA_INDEX=0

# Set to false to use text-only fallback (no image in API call)
VISION_ENABLED=true

# Maximum skill steps per turn
MAX_PLAN_STEPS=5

# Save last captured frame to debug_frame.jpg each turn
DEBUG_SAVE_FRAME=false
