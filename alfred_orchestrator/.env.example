

# OpenAI — required for planner LLM (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# ElevenLabs — required for STT + TTS (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# SerpAPI — required for amazon_search skill (https://serpapi.com/manage-api-key)
SERPAPI_KEY=

# Amazon Associates tracking tag — required for cart-add URL to render the Please-Confirm page.
# Leave blank to use the project default (sebilee2026-20).
AMAZON_ASSOCIATES_TAG=

# Optional model/provider settings.
OPENAI_REASONING_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STT_MODEL=scribe_v1

# Local hardware defaults.
ALFRED_CAMERA_ID=0
ALFRED_RECORD_SECONDS=5
ALFRED_RUNS_DIR=runs
ALFRED_ENABLE_PHYSICAL_SKILLS=false
