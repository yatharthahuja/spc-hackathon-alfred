

# Optional model/provider settings.
OPENAI_REASONING_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STT_MODEL=scribe_v1

# Amazon Creators API (recommended; replaces PA-API 5).
# Docs: https://affiliate-program.amazon.com/creatorsapi/docs/en-us/api-reference/operations/search-items
# Credentials: Associates → Tools → Creators API
AMAZON_API=creators
AMAZON_USE_MOCK=true
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=2.1
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_SEARCH_INDEX=All
# Optional OAuth override (version 2.1 → us-east-1 Cognito by default)
# AMAZON_AUTH_ENDPOINT=

# Legacy PA-API 5 only (set AMAZON_API=paapi)
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_HOST=webservices.amazon.com
# AMAZON_REGION=us-east-1

# Local hardware defaults.
ALFRED_CAMERA_ID=0
ALFRED_RECORD_SECONDS=5
ALFRED_RUNS_DIR=runs
ALFRED_ENABLE_PHYSICAL_SKILLS=false
