

# Optional model/provider settings.
OPENAI_REASONING_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STT_MODEL=scribe_v1

# Amazon PA-API (Associates Product Advertising API 5.0).
# Get keys: https://affiliate-program.amazon.com/ → Tools → Product Advertising API
AMAZON_USE_MOCK=true
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_HOST=webservices.amazon.com
AMAZON_REGION=us-east-1
AMAZON_SEARCH_INDEX=All

# Local hardware defaults.
ALFRED_CAMERA_ID=0
ALFRED_RECORD_SECONDS=5
ALFRED_RUNS_DIR=runs
ALFRED_ENABLE_PHYSICAL_SKILLS=false
